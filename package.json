{
  "name": "mybadcoach",
  "version": "0.0.0",
  "private": true,
  "description": "Real-time, collaborative, offline-first Ultimate Frisbee live stat tracker",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "test": "npm run test:shared && npm run test:server",
    "test:shared": "npm run test -w packages/shared",
    "test:server": "cd server && go test ./...",
    "dev": "bash scripts/dev.sh",
    "build:server": "cd server && go build -o ../dist/server ./cmd/server",
    "dev:client": "npm run dev -w apps/client",
    "build:client": "npm run build -w apps/client",
    "verify:rules": "bash scripts/verify-usau-rules-md.sh",
    "verify:client": "bash scripts/verify-client-skeleton.sh"
  }
}
