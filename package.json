{
  "name": "mybadcoach",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time, collaborative, offline-first Ultimate Frisbee live stat tracker",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "test": "npm run test:shared && npm run test:server",
    "test:shared": "npm run test -w packages/shared",
    "test:server": "cd server && go test ./...",
    "test:e2e": "docker compose run --rm e2e",
    "lint": "bash scripts/lint.sh",
    "generate": "bash scripts/generate.sh",
    "dev": "bash scripts/dev.sh",
    "build:server": "bash scripts/copy-client-build.sh && cd server && go build -o ../dist/server ./cmd/server",
    "build": "npm run build:client && npm run build:server",
    "dev:client": "npm run dev -w apps/client",
    "build:client": "npm run build -w apps/client",
    "verify:rules": "bash scripts/verify-usau-rules-md.sh",
    "verify:client": "bash scripts/verify-client-skeleton.sh",
    "test:integration:frontend": "npm test --prefix e2e -- --config=playwright.frontend.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "svelte-eslint-parser": "1.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
